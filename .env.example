# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-key-here

# Orchestrator Configuration
ORCHESTRATOR_API_KEY=your-secret-api-key
ORCHESTRATOR_HOST=0.0.0.0
ORCHESTRATOR_PORT=8080

# AI Provider Configuration
# Default provider: claude, codex, gemini, opencode
ORCHESTRATOR_DEFAULT_PROVIDER=claude

# Provider CLI commands (override if not in PATH or custom location)
ORCHESTRATOR_CLAUDE_COMMAND=claude
ORCHESTRATOR_CODEX_COMMAND=codex
ORCHESTRATOR_GEMINI_COMMAND=gemini
ORCHESTRATOR_OPENCODE_COMMAND=opencode

# MCP Server Configuration
# Full path to Python in your virtual environment (required for MCP server)
MCP_PYTHON_PATH=/path/to/AgentTaskPlanner/env/bin/python

# Session Management Configuration
# Timeout (seconds) before marking disconnected sessions for cleanup (default: 900 = 15 minutes)
SESSION_TEMP_DISCONNECT_TIMEOUT=900

# Timeout (seconds) before removing abandoned sessions from memory (default: 3600 = 1 hour)
SESSION_ABANDONED_TIMEOUT=3600

# Interval (seconds) for background cleanup task to run (default: 300 = 5 minutes)
SESSION_CLEANUP_INTERVAL=300

# Maximum number of reconnections allowed per session (default: 50)
SESSION_MAX_RECONNECTIONS=50

# Optional: Tailscale configuration
TAILSCALE_IP=100.x.x.x
