# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Orchestrator Configuration
#
# IMPORTANT (native iOS / Capacitor build): Vite inlines these at BUILD time.
# The bundled app's origin is capacitor://localhost, so the localhost fallback
# in src/lib/orchestrator.ts will NOT reach your Mac — you MUST set an explicit
# URL here and rebuild (`npm run build && npx cap sync`) after any change.
#
# Use your Tailscale MagicDNS name over HTTPS (required by iOS App Transport
# Security). Plain http:// is blocked on device and also yields an insecure
# ws:// (the client derives the WS scheme from this URL).
#   Local web dev:  http://localhost:8080
#   Native / phone: https://<machine>.<tailnet>.ts.net:8080
VITE_ORCHESTRATOR_URL=http://localhost:8080
VITE_ORCHESTRATOR_API_KEY=your-secret-api-key
